# =============================================================================
# Crypto Market Advisor — example environment
# Copy to .env and adjust. Never commit the real .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_USER=advisor
POSTGRES_PASSWORD=advisor
POSTGRES_DB=advisor
# Host port for PostgreSQL. Change it if 5432 is already taken locally.
POSTGRES_PORT=5432

# Used by the backend when it runs outside Docker (inside Compose it is set
# automatically to the postgres service).
DATABASE_URL=postgres://advisor:advisor@localhost:5432/advisor?sslmode=disable
DATABASE_AUTO_MIGRATE=true

# -----------------------------------------------------------------------------
# HTTP
# -----------------------------------------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=3000
# Comma-separated list, or * for any origin (local single-user app).
HTTP_CORS_ORIGINS=*

# -----------------------------------------------------------------------------
# CoinGecko — market metadata only
#
# Prices and candles come from Bybit's public endpoints. CoinGecko supplies what
# an exchange does not publish: market capitalisation, its ranking, and with it
# the automatic top-N universe. It is not a candle source: an asset Bybit does
# not list is reported as untradable rather than analysed on derived bars.
#
# A key is optional. The public tier works without one.
# -----------------------------------------------------------------------------
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Public Bybit spot market data (no API key or authorization required).
BYBIT_MARKET_DATA_ENABLED=true
BYBIT_MARKET_BASE_URL=https://api.bybit.com
BYBIT_MARKET_TIMEOUT=15s
BYBIT_MARKET_MAX_RETRIES=2
BYBIT_MARKET_RETRY_BASE_WAIT=1s
BYBIT_MARKET_RATE_LIMIT_RPM=300
# Optional. Leave empty to use the public tier.
COINGECKO_API_KEY=
# Demo (free) keys use x-cg-demo-api-key; Pro keys use x-cg-pro-api-key together
# with COINGECKO_BASE_URL=https://pro-api.coingecko.com/api/v3
COINGECKO_API_KEY_HEADER=x-cg-demo-api-key
COINGECKO_VS_CURRENCY=usd
COINGECKO_TIMEOUT=20s
COINGECKO_MAX_RETRIES=3
COINGECKO_RETRY_BASE_WAIT=1s
# Client-side request budget. The public tier is stricter than the paid ones;
# lower this if you see HTTP 429 in the logs.
COINGECKO_RATE_LIMIT_RPM=25
COINGECKO_CACHE_TTL=45s

# -----------------------------------------------------------------------------
# News Intelligence — public feeds, no API keys required
# -----------------------------------------------------------------------------
NEWS_ENABLED=true
NEWS_FETCH_INTERVAL=5m
NEWS_FETCH_CONCURRENCY=4
NEWS_HTTP_TIMEOUT=15s
NEWS_MAX_RETRIES=2
NEWS_RETRY_BASE_WAIT=1s
# Hard response-body limit per source (2 MiB by default).
NEWS_MAX_RESPONSE_BYTES=2097152
# Keep false outside isolated development/tests: enables loopback/private feeds.
NEWS_ALLOW_PRIVATE_FEEDS=false
NEWS_LLM_LOOKBACK=24h
NEWS_LLM_MAX_ASSET_ITEMS=8
NEWS_LLM_MAX_GLOBAL_ITEMS=5
NEWS_CLUSTER_TIME_WINDOW=6h
NEWS_TITLE_SIMILARITY_THRESHOLD=0.72
# Historical aggregates stay unavailable below this sample size.
NEWS_HISTORY_MIN_SAMPLE_SIZE=20
# Incremental 5m/15m/1h/4h/24h market-reaction evaluation.
NEWS_REACTION_INTERVAL=5m
# Missing baseline becomes explicit insufficient_data after this window.
NEWS_REACTION_BASELINE_GRACE=2h
NEWS_BYBIT_ENABLED=true
# Optional and disabled by default; RSS/Atom + Bybit are sufficient for MVP.
NEWS_GDELT_ENABLED=false

# -----------------------------------------------------------------------------
# Analysis
# -----------------------------------------------------------------------------
# Number of automatically tracked top assets (stablecoins and wrapped/staked
# tokens are filtered out). Manually added assets are kept on top of this.
MARKET_UNIVERSE_SIZE=20
MARKET_UNIVERSE_REFRESH=24h

# Starts the periodic analysis cycle. The UI switch for background analysis
# overrides this at runtime; market data, news and outcome bookkeeping keep
# running either way.
ANALYSIS_ENABLED=true
ANALYSIS_INTERVAL=5m
ANALYSIS_TIMEFRAMES=1m,5m,15m,1h,4h,1d
# How often the exchange tickers are polled for the market overview.
MARKET_DATA_INTERVAL=1m
ANALYSIS_MAX_CONCURRENT_SYMBOLS=4
ANALYSIS_CANDLE_HISTORY=500
# The asset whose daily trend stands for the market as a whole. The deterministic
# policy refuses to trade against it, which is what keeps a long-only profile out
# of falling markets. Leave empty to disable that filter entirely.
ANALYSIS_BENCHMARK_SYMBOL=BTC
# Anti-spam guard for the "analyse now" button.
ANALYSIS_MANUAL_COOLDOWN=60s
# A recommendation older than this is shown as "stale" in the UI.
RECOMMENDATION_STALE_AFTER=30m
OUTCOME_EVALUATION_INTERVAL=5m

# -----------------------------------------------------------------------------
# LLM (OpenAI-compatible server: llama.cpp, vLLM, Ollama in OpenAI mode, ...)
# -----------------------------------------------------------------------------
LLM_ENABLED=true
# Inside Compose with the llm profile: http://llm:8080/v1
# For an inference server on the host OS: http://host.docker.internal:8080/v1
LLM_BASE_URL=http://llm:8080/v1
LLM_API_KEY=
LLM_MODEL=Qwen3-8B
LLM_TIMEOUT=180s
LLM_TEMPERATURE=0.2
# Maximum generated response length. This is not the model context window.
LLM_MAX_TOKENS=1800
# Total prompt + response window. Must match llama.cpp --ctx-size below.
LLM_CONTEXT_SIZE=16384
# The UI warns when (measured prompt + reserved response) reaches this share of
# the context window, so an approaching overflow is visible before llama.cpp
# rejects the request itself. The market snapshot deliberately uses the room the
# window leaves, so a healthy run already sits around 70-85%; these thresholds
# mark the point where a refusal becomes likely.
LLM_CONTEXT_WARN_PCT=90
LLM_CONTEXT_CRITICAL_PCT=97
# Optional cap on the market snapshot itself. Empty or 0 means the snapshot uses
# whatever the context window leaves after the system prompt and the response
# reservation, so enlarging LLM_CONTEXT_SIZE really does give the model more
# data. Set a number only if you prefer shorter prompts for speed.
LLM_SNAPSHOT_MAX_TOKENS=0
# One local GPU serves one request/llama.cpp slot at a time; raising this also
# increases KV-cache memory use and requires restarting the LLM container.
LLM_MAX_CONCURRENT_REQUESTS=1
LLM_PROMPT_VERSION=market_advisor_v3_news

# Settings for the optional bundled llama.cpp service (docker compose --profile llm)
LLM_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
LLM_MODEL_DIR=./models
LLM_MODEL_FILE=Qwen_Qwen3-8B-Q5_K_M.gguf
LLM_GPU_LAYERS=999
LLM_REASONING=off
LLM_PORT=8081

# -----------------------------------------------------------------------------
# Risk management
# -----------------------------------------------------------------------------
RISK_MIN_LEVERAGE=5
RISK_MAX_LEVERAGE=50
MAX_RECOMMENDED_ALLOCATION_PCT=15
# Share of capital a stop-out is allowed to cost. Above zero the advised size is
# derived from the stop distance instead of being a fixed share, so a quiet asset
# and a volatile one carry the same risk. Zero restores the fixed allocation.
RISK_PER_TRADE_PCT=0.75
# ATR as a percentage of price; above these levels the engine cuts leverage.
RISK_HIGH_VOLATILITY_ATR_PCT=1.5
RISK_EXTREME_VOLATILITY_ATR_PCT=3.0
# Below this confidence the engine forces the minimum leverage.
RISK_MIN_CONFIDENCE=55
RISK_CRITICAL_NEWS_MAX_LEVERAGE=15
RISK_CRITICAL_NEWS_HIGH_VOL_MAX_LEVERAGE=8
RISK_CRITICAL_NEWS_MAX_AGE=2h

# -----------------------------------------------------------------------------
# Fees
#
# IMPORTANT: no default fee rates are shipped. The official Bybit fee page could
# not be verified automatically (it returns HTTP 403 to programmatic requests),
# and inventing a rate would silently falsify your P&L. Look up your own tier at
#   https://www.bybit.com/en/help-center/article/Trading-Fee-Structure
# and enter the values here or in the Settings screen. Until both are set, the
# application treats fees as unknown and marks affected numbers as approximate.
# -----------------------------------------------------------------------------
EXCHANGE=bybit
DEFAULT_MAKER_FEE_PCT=
DEFAULT_TAKER_FEE_PCT=
DEFAULT_SLIPPAGE_PCT=0.02
# Funding is entered manually: the project uses no private account endpoints.
FUNDING_MANUAL_ONLY=true

# -----------------------------------------------------------------------------
# Backtesting
# -----------------------------------------------------------------------------
# Hard ceiling on how many inferences one LLM backtest may consume.
BACKTEST_MAX_INFERENCES=2000
BACKTEST_CACHE_ENABLED=true
BACKTEST_DEFAULT_SLIPPAGE_PCT=0.02
# Do not invent exchange-specific values: set the expected 8-hour funding rate
# and maintenance margin for the contract tier being tested. Zero means no
# funding and liquidation at the bankruptcy price.
#
# This flat rate is only the fallback. Settled funding is downloaded from Bybit's
# public funding-history endpoint (no API key) and a backtest charges the rate
# that actually applied whenever the history covers the period.
BACKTEST_DEFAULT_FUNDING_RATE_PCT=0
BACKTEST_DEFAULT_MAINTENANCE_MARGIN_PCT=0
BACKTEST_DEFAULT_MAX_OPEN_POSITIONS=1
BACKTEST_MAX_CONCURRENT=1
# Pause after every backtest request that actually reached the model, so a long
# LLM replay does not hold the GPU at full load from start to finish. Cached
# answers are not delayed. Empty or 0 runs without pauses.
BACKTEST_INFERENCE_PAUSE=1s
# How long one background run may take before it is cancelled and stored as
# failed. An LLM replay of BACKTEST_MAX_INFERENCES steps costs several seconds
# per step plus the pause above, so keep this above the worst case you intend to
# run: a timeout in the middle throws away every inference already spent.
BACKTEST_RUN_TIMEOUT=12h

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# debug | info | warn | error. Full LLM prompts are logged only at debug.
LOG_LEVEL=info
# json | text
LOG_FORMAT=json
APP_ENV=production

# -----------------------------------------------------------------------------
# Settings precedence
# -----------------------------------------------------------------------------
# Anything you change in the Settings screen is stored in the database and wins
# over the variables above, so a restart never reverts a deliberate UI change.
# Set this to true for one start to force the stored settings back to whatever
# this .env says (useful after editing LLM_BASE_URL or the risk bounds by hand).
SETTINGS_FROM_ENV=false
